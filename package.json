  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:native": "node scripts/build-native.mjs",
    "start": "node server/mcp.mjs",
    "preview": "node server/preview.mjs",
    "test": "node --test test/*.test.mjs",
