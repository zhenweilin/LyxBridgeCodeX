    "katex": "0.18.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  },
  "description": "Native LyX editing and document context for Codex",
  "license": "(Apache-2.0 AND GPL-2.0-or-later)",
